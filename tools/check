# virtual machine mode (--qemu) is not ported.
"""
Build a project's fuzz targets the way we do, collect the binaries, and write the build manifest.

    tools/check <name>                  build projects/<name>: every build its project.yaml asks for
    tools/check --build asan <name>     only some builds (repeat --build; plain, ubsan, asan, asan-ubsan)
    tools/check --twice <name>          then build it all again from scratch, and compare every byte
    tools/check --lock <file> <name>    compare with a lock: a manifest from an earlier check, or a harness.yaml
    tools/check --no-shell <name>       stop after the build instead of opening a shell

It runs these steps:

    1. Check projects/<name>/ against the enrollment rules (tools/validate.py).
    2. Resolve repo#ref to a full commit id (git ls-remote), unless the ref is one. With --lock, the lock's commit.
    3. Build the builder image from infra/base-builder, FROM the pinned toolchain image.
    4. Build the project's Dockerfile on it with --build-arg COMMIT=<commit> (and REPO, BASE_BUILDER). The network
       is available. The build context is projects/<name>/, or your repository at that commit if dockerfile: is set.
    5. Run `compile` once per build, each in a fresh container with no network (docker run --network=none).
    6. Find the fuzz targets: executables in $OUT whose symbol table defines LLVMFuzzerTestOneInput, present in every
       build (or those fuzz_targets lists). Collect each one's published (stripped) bytes as
       out/<target>/<target>.<build>.
    7. Write manifest.yaml: the repository, ref and commit, this repository's commit, the builder, the git checkouts
       in the image, and the file, size and SHA-256 of every target in every build.
    8. Open a shell in the project image with no network and out/ at /out, unless --no-shell.

Everything is kept in ~/.cache/oss-verifier-check/<name>, or in --dir if given.

Security note: the project's Dockerfile is built with network access, as `docker build` would. Check a project from
someone you don't trust on a machine with nothing to lose.

Exit codes: 0 if the project builds (and, with --twice or --lock, every byte matches); 1 if it does not build; 2 if
projects/<name>/ breaks the enrollment rules; 3 if it builds but the bytes differ (--twice or --lock).

Requires git, Docker (with the toolchain image available) and PyYAML (pip install pyyaml).
"""
import argparse
import pathlib
import subprocess
import sys

import check_build
import manifest
import validate
from check_build import Failed, Job, say, step

DIFFERENT = 3


def load(project):
    """Validate a project and return its Job. Exit with code 2 if it breaks the enrollment rules.

    `project` is either a name under projects/ or the path of a directory containing a project.yaml.
    """
    directory = pathlib.Path(project)
    if not (directory / "project.yaml").exists() and len(directory.parts) == 1:
        directory = validate.PROJECTS / project
    directory = directory.absolute()
    problems, warnings, _ = validate.check_project(directory)
    if problems:
        for problem in problems:
            print(validate.printable(f"{directory.name}: {problem}"), file=sys.stderr)
        sys.exit(2)
    for warning in warnings:
        say(f"{directory.name}: warning: {warning}")

    config = validate.load(directory)
    repo, _, ref = config["repo"].partition("#")
    beside = {path.name for path in directory.iterdir()}
    return Job(
        name=directory.name,
        directory=directory,
        repo=repo,
        ref=ref,
        dockerfile="" if "Dockerfile" in beside else config["dockerfile"],
        builds=validate.builds_of(config),
        fuzz_targets=config.get("fuzz_targets"),
    )


def build_all(job, commit, work, suffix="", no_cache=False):
    """Build the images, compile every build and collect the fuzz targets into work/out.

    Return (builder tag, project tag, targets, entries). Raise Failed if any step fails.
    """
    builder = check_build.build_builder(suffix, no_cache)
    tag = f"oss-verifier-check/{job.name}:{commit[:12]}{suffix}"
    check_build.build_project(job, commit, builder, tag, work, no_cache)
    raw = {}
    for build in job.builds:
        raw[build] = work / "raw" / build
        check_build.compile_build(tag, build, validate.BUILDS[build], raw[build])

    step("find the fuzz targets")
    found = {build: manifest.discover(directory) for build, directory in raw.items()}
    targets, problems = manifest.resolve_targets(found, job.fuzz_targets)
    for build, names in found.items():
        say(f"{build}: {', '.join(names) or 'no fuzz target'}")
    entries, missing = manifest.collect(raw, targets, work / "out")
    if problems or missing:
        raise Failed("\n  ".join(["the fuzz targets are not right:", *problems, *missing]))
    return builder, tag, targets, entries


def shell(tag, out):
    """Open bash in the project image, as compile sees it, with no network and the collected binaries at /out."""
    say(f"\n── a shell in {tag}, with no network; /out holds the binaries collected. exit or Ctrl-D ends it ──\n")
    container = ["--rm", "-i", "--init", "--network", "none", "-v", f"{out}:/out:ro"]
    if sys.stdin.isatty():
        container.append("-t")
    subprocess.call(["docker", "run", *container, tag, "bash"])


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("project", help="a name under projects/, or the path of a directory with a project.yaml")
    parser.add_argument("--build", action="append", choices=list(validate.BUILDS), help="only this build (repeatable)")
    parser.add_argument("--twice", action="store_true", help="build everything a second time from scratch and compare")
    parser.add_argument("--lock", type=pathlib.Path, help="compare with this lock (a manifest or a harness.yaml)")
    parser.add_argument("--no-shell", action="store_true", help="stop after the build")
    parser.add_argument("--dir", type=pathlib.Path, help=f"where to work (default: {check_build.CACHE}/<name>)")
    options = parser.parse_args()

    job = load(options.project)
    if options.build:
        unknown = [build for build in options.build if build not in job.builds]
        if unknown:
            sys.exit(f"tools/check: {job.name} has no {', '.join(unknown)} build (it has {', '.join(job.builds)})")
        job.builds = [build for build in job.builds if build in options.build]
    work = (options.dir or check_build.CACHE / job.name).absolute()
    work.mkdir(parents=True, exist_ok=True, mode=0o700)

    pins, locked = None, None
    if options.lock:
        try:
            locked, pins = manifest.load_lock(options.lock)
        except manifest.LockError as error:
            sys.exit(f"tools/check: {error}")

    try:
        step(f"resolve {job.repo}" + (f"#{job.ref}" if job.ref else " (default branch)"))
        commit = check_build.resolve(job.repo, job.ref)
        say(f"{job.ref or 'the default branch'} is {commit}")
        if locked and locked != commit:
            say(f"the lock is for {locked}: building that commit")
            commit = locked
        builder, tag, targets, entries = build_all(job, commit, work)
    except Failed as failure:
        say(f"\nBUILD FAILED: {failure}")
        return 1

    data = manifest.manifest(
        project=job.name, repo=job.repo, ref=job.ref, commit=commit, oss_verifier=check_build.oss_verifier_state(job),
        builder={"toolchain": check_build.toolchain(), "image": check_build.image_id(builder),
                 "project_image": check_build.image_id(tag)},
        sources=check_build.sources(tag), builds=job.builds, targets=targets, entries=entries,
    )
    manifest.write_manifest(work / "manifest.yaml", data)
    step("built")
    for target in targets:
        for build in job.builds:
            entry = entries[target][build]
            say(f"  out/{target}/{entry['file']:<40} {entry['bytes']:>10,} bytes  sha256 {entry['sha256']}")
    say(f"manifest: {work / 'manifest.yaml'}")

    code = 0
    if options.twice:
        try:
            step("--twice: everything again, from scratch")
            _, _, _, again = build_all(job, commit, work / "twice", "-twice", no_cache=True)
        except Failed as failure:
            say(f"\nTHE SECOND BUILD FAILED: {failure}")
            return 1
        first = {(target, build): entry for target in entries for build, entry in entries[target].items()}
        differences, extras, matched = manifest.compare(again, first, job.builds)
        differences += extras
        if differences:
            say("\nNOT REPRODUCIBLE: the second build differs:\n  " + "\n  ".join(differences))
            code = DIFFERENT
        else:
            say(f"\nreproducible: all {matched} binaries are byte for byte the same in the second build")
    if pins is not None:
        differences, extras, matched = manifest.compare(entries, pins, job.builds)
        if extras:
            say("\nnot in the lock (not compared):\n  " + "\n  ".join(extras))
        if differences:
            say(f"\nDIFFERENT FROM THE LOCK ({options.lock}):\n  " + "\n  ".join(differences))
            code = DIFFERENT
        elif matched:
            say(f"\nmatches the lock: all {matched} binaries it pins for these builds are byte for byte the same")
        else:
            say(f"\nTHE LOCK PINS NONE OF THESE BUILDS ({options.lock})")
            code = DIFFERENT

    if not options.no_shell:
        shell(tag, work / "out")
    return code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
